{
	"name": "@rt911/frontend",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite -d",
		"build": "tsc -b && vite build",
		"test": "vitest run",
		"lint": "oxlint .",
		"preview": "vite preview",
		"preview:auth": "tsc -b && vite build --mode preview && vite preview",
		"use:local": "npm link classicy --ignore-scripts",
		"use:published": "npm unlink classicy && npm install",
		"proxy": "npm run proxy:up",
		"proxy:cycle": "npm run proxy:down && npm run proxy:up",
		"proxy:up": "cd timemachine && docker compose up --build --force-recreate -d",
		"proxy:down": "cd timemachine && docker compose down",
		"e2e": "playwright test",
		"e2e:ui": "playwright test --ui",
		"e2e:headed": "playwright test --headed",
		"codegen": "playwright codegen"
	},
	"dependencies": {
		"@msgpack/msgpack": "^3.1.3",
		"@openreplay/tracker": "^18.1.2",
		"classicy": "latest",
		"classnames": "^2.5.1",
		"dompurify": "^3.4.14",
		"html2canvas-pro": "^2.3.9",
		"maplibre-gl": "^6.5.0",
		"pmtiles": "^4.4.1",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-fast-marquee": "^1.6.5",
		"react-player": "^3.4.0",
		"sass-embedded": "^1.103.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@playwright/test": "^1.62.1",
		"@testing-library/react": "^16.3.2",
		"@types/dompurify": "^3.0.5",
		"@types/geojson": "^7946.0.16",
		"@types/node": "^26.2.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^6.1.0",
		"jsdom": "^30.0.1",
		"oxlint": "^1.79.0",
		"typescript": "~7.0.2",
		"vite": "^8.2.2",
		"vitest": "^4.1.11"
	},
	"volta": {
		"node": "25.2.0"
	}
}
