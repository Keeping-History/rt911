{
	"name": "@rt911/frontend",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite -d",
		"build": "tsc -b && vite build",
		"test": "vitest run",
		"lint": "oxlint .",
		"preview": "vite preview",
		"preview:auth": "tsc -b && vite build --mode preview && vite preview",
		"use:local": "pnpm link ${CLASSICY_DIR:-../../../classicy} ${CLASSICY_DIR:-../../../classicy}/packages/appearance/platinum",
		"use:published": "pnpm unlink @classicy/classicy @classicy/appearance-platinum",
		"proxy": "npm run proxy:up",
		"proxy:cycle": "npm run proxy:down && npm run proxy:up",
		"proxy:up": "cd timemachine && docker compose up --build --force-recreate -d",
		"proxy:down": "cd timemachine && docker compose down",
		"e2e": "playwright test",
		"e2e:ui": "playwright test --ui",
		"e2e:headed": "playwright test --headed",
		"codegen": "playwright codegen"
	},
	"dependencies": {
		"@classicy/appearance-platinum": "^3.1.1",
		"@classicy/classicy": "^3.1.1",
		"@msgpack/msgpack": "^3.1.3",
		"@openreplay/tracker": "^19.0.5",
		"classnames": "^2.5.1",
		"dompurify": "^3.4.17",
		"html2canvas-pro": "^2.6.0",
		"maplibre-gl": "^6.16.0",
		"pmtiles": "^4.4.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-fast-marquee": "^1.6.5",
		"react-player": "^3.4.0",
		"sass-embedded": "^1.107.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.1",
		"@testing-library/react": "^16.3.3",
		"@types/dompurify": "^3.0.5",
		"@types/geojson": "^7946.0.16",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.2.1",
		"jsdom": "^30.1.3",
		"oxlint": "^1.91.0",
		"typescript": "~7.0.2",
		"vite": "^8.3.5",
		"vitest": "^5.1.0"
	},
	"volta": {
		"node": "25.2.0"
	}
}
